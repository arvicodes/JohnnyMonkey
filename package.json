{
  "name": "johnny-monkey",
  "version": "1.0.0",
  "description": "Educational platform with database backup integration",
  "main": "index.js",
  "scripts": {
    "backup": "bash scripts/backup-manager.sh create",
    "backup:list": "bash scripts/backup-manager.sh list",
    "backup:cleanup": "bash scripts/backup-manager.sh cleanup",
    "backup:restore": "bash scripts/backup-manager.sh restore",
    "git:commit": "bash scripts/backup-manager.sh create && git add . && git commit -m \"Auto-backup: $(date)\"",
    "git:push": "git push",
    "postinstall": "chmod +x scripts/backup-manager.sh && chmod +x .git/hooks/pre-commit && chmod +x .git/hooks/pre-push"
  },
  "keywords": ["education", "database", "backup", "git"],
  "author": "",
  "license": "ISC"
}
