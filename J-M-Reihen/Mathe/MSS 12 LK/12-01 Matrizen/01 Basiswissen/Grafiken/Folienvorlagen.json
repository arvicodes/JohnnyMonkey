      "payload": {
        "layout": "title-content",
        "title": "Auf nach draußen ...",
        "body": "Wir gehen frei herum .... Tausche dich mit so vielen Mitschüler:innen über dein Bild, deine KI aus. Beschreibe deine KI. Dein Gegenüber benennt mögliche Probleme. Diskutiert.Besuche alle 10 Stationen. Trefft je eine andere Person an einer der Stationen. Einigt euch  gemeinsam ein eine Begriffserklärung und ein Beispiel. Schreibt diese auf die vorliegenden Karteikarten.",
        "speakerNotes": "Material:Karten mit den 10 Begriffen. Leere Karten pro Station",
        "preparationNotes": "",
        "materialNotes": "",
        "subtitle": "",
        "bodyLeft": "",
        "bodyRight": "",
        "imagePath": "",
        "imageCaption": "",
        "bodyStyle": "plain",
        "titleAlign": "left",
        "accentColor": "#2E7D32",
        "titleHtml": "Auf nach draußen ...",
        "bodyHtml": "<div style=\"\"><br></div><div style=\"\"><br></div><div style=\"\"><br></div><div style=\"\"><br></div><div style=\"\"><br></div><div style=\"\"><br></div><div style=\"\">Wir gehen frei herum ....&nbsp;<span style=\"font-weight: bold;\">Tausche</span> dich mit so vielen Mitschüler:innen über dein Bild, deine KI aus. <span style=\"font-weight: bold;\">Beschreibe</span> deine KI. Dein Gegenüber <span style=\"font-weight: bold;\">benennt</span> mögliche Probleme. <span style=\"font-weight: bold;\">Diskutiert</span>.</div><div><br></div><div><br></div><div><br></div><div><br></div><div><br></div><div><br></div><div><br></div><div><span style=\"font-weight: bold;\">Besuche</span> alle 10 Stationen.&nbsp;<span style=\"font-weight: bold;\">Trefft</span> je eine andere Person an einer der Stationen. <span style=\"font-weight: bold;\">Einigt</span> euch&nbsp; gemeinsam ein eine Begriffserklärung und ein Beispiel. <span style=\"font-weight: bold;\">Schreibt</span> diese auf die vorliegenden Karteikarten.</div>",
        "subtitleHtml": "",
        "bodyLeftHtml": "",
