generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Copy all models from main schema
// Copy all models from main schema
model User {
  id                        String                      @id @default(uuid())
  name                      String
  loginCode                 String                      @unique
  role                      String                      @default("STUDENT")
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  avatarEmoji               String?
  avatarUrl                 String?
  profileColor              String?
  teacherGroups             LearningGroup[]             @relation("TeacherGroups")
  notes                     Note[]
  quizzes                   Quiz[]
  participations            QuizParticipation[]
  subjects                  Subject[]
  learningGroups            LearningGroup[]             @relation("StudentGroups")
  grades                    Grade[]
  fileSystemPaths           FileSystemPath[]
  flashcardDecks            FlashcardDeck[]
  flashcardProgress         FlashcardProgress[]
  learningSessions          FlashcardLearningSession[]
  documentProcessingHistory DocumentProcessingHistory[]
  teacherAssignments        Assignment[]                @relation("TeacherAssignments")
  studentSubmissions        Submission[]                @relation("StudentSubmissions")
  classParticipations       Participation[]             @relation("StudentParticipations")
  epoGrades                 ParticipationPeriodGrade[]  @relation("StudentEPOGrades")
  adventSubmissions         AdventCalendarSubmission[]
  kaSubmissions             KASubmission[]              @relation("StudentKASubmissions")
  kaCorrections             KACorrection[]              @relation("TeacherKACorrections")
  sentMessages              Message[]                   @relation("TeacherMessages")
  receivedMessages          Message[]                   @relation("StudentMessages")
  gradeReleases             GradeRelease[]
  teacherLessonInstructions TeacherLessonInstruction[]
  journeyProgress         StudentJourneyProgress?
  scheduleSettings          TeacherScheduleSettings?
  timetableUploads          TeacherTimetableUpload[]
  scheduleSlots             ScheduleSlot[]
  autoLessonSessions        AutoLessonSession[]
  wochenaufgabeVideoClaims  WochenaufgabeTask[]      @relation("WaVideoClaim")
  wochenaufgabePeerReviews  WochenaufgabePeerPair[]  @relation("WaPeerReviewer")
  wochenaufgabePeerSolutions WochenaufgabePeerPair[] @relation("WaPeerSolution")
  moderatedGroups           LearningGroup[]             @relation("GroupModerator")
}

// Gamification: „Reisebegleiter“ – Reisekräfte sammeln, Ei finden, ausbrüten, Begleiter wachsen lassen
model StudentJourneyProgress {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// „Weite“ – vorankommen, aktiv sein (Quiz, tägliche Nutzung, Abgaben …)
  weitePoints   Int @default(0)
  /// „Funken“ – Neugier, Neues entdecken
  funkenPoints  Int @default(0)
  /// „Hingabe“ – konzentriert üben (Karteikarten, Fleiß)
  hingabePoints Int @default(0)

  /// JOURNEY | EGG | HATCHLING | YOUNG | BUDDY
  companionStage String @default("JOURNEY")

  eggCarePercent Int       @default(0)
  lastCareDate   String?
  eggFoundAt     DateTime?
  hatchedAt      DateTime?

  lastDailyVisitDate String?

  /// Fortschritt nach dem Schlupf (für Entwicklungsstufen)
  postHatchXp Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GradingSchema {
  id            String        @id @default(uuid())
  name          String
  structure     String
  groupId       String
  gradingSystem String        @default("GERMAN") // GERMAN oder MSS
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  learningGroup LearningGroup @relation(fields: [groupId], references: [id])
  grades        Grade[]
  gradeReleases GradeRelease[]
}

model Grade {
  id           String        @id @default(uuid())
  studentId    String
  schemaId     String
  categoryName String
  grade        Float
  weight       Float
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  student      User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schema       GradingSchema @relation(fields: [schemaId], references: [id], onDelete: Cascade)

  @@unique([studentId, schemaId, categoryName])
}

// Freigabe der Gesamtnote für Schüler
model GradeRelease {
  id         String        @id @default(uuid())
  studentId  String
  schemaId   String
  isReleased Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  student    User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schema     GradingSchema @relation(fields: [schemaId], references: [id], onDelete: Cascade)

  @@unique([studentId, schemaId])
  @@index([studentId])
  @@index([schemaId])
}

model LearningGroup {
  id                   String                     @id @default(uuid())
  name                 String
  iconEmoji            String?
  color                String?
  displayOrder         Int?
  isArchived           Boolean                    @default(false)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  teacherId            String
  period1Hours         Int? // Anzahl Stunden für Zeitraum 1 (EPO 1)
  period2Hours         Int? // Anzahl Stunden für Zeitraum 2 (EPO 2)
  seatingOrder         String? // JSON-Array mit Schüler-IDs in benutzerdefinierter Reihenfolge
  statisticsOrder      String? // JSON-Array mit Schüler-IDs in benutzerdefinierter Reihenfolge für Epochalstatistik
  /** JSON-Array: Schüler-IDs die in dieser Gruppe passiv sind (z. B. Auslandsaufenthalt) */
  passiveStudentIds    String?
  gradingSchemas       GradingSchema[]
  assignments          GroupAssignment[]
  flashcardAssignments FlashcardAssignment[]
  fileShares           FileShare[]
  participations       Participation[]
  epoGrades            ParticipationPeriodGrade[]
  lessonKeywords       LessonKeyword[]
  lessonSharedInputs   LessonSharedInput[]
  lessonSharedInputShares LessonSharedInputShare[]
  lessonCollabFlashcardBeacons LessonCollabFlashcardBeacon[]
  lessonExamBeacons            LessonExamBeacon[]
  scheduleSlots                ScheduleSlot[]
  autoLessonSessions           AutoLessonSession[]
  wochenaufgabeTasks           WochenaufgabeTask[]
  /** Aktueller Klassen-Moderator (z. B. für die Woche) — sieht volles Entry Ticket */
  moderatorStudentId           String?
  moderator                    User?                      @relation("GroupModerator", fields: [moderatorStudentId], references: [id], onDelete: SetNull)
  teacher              User                       @relation("TeacherGroups", fields: [teacherId], references: [id])
  students             User[]                     @relation("StudentGroups")

  @@index([moderatorStudentId])
}

/// Lehrer startet Prüfung separat → SuS bekommen Vollbild-Overlay (Poll).
model LessonExamBeacon {
  groupId    String        @id
  filePath   String
  lessonPath String        @default("")
  beaconId   String
  active     Boolean       @default(true)
  updatedAt  DateTime      @updatedAt
  group      LearningGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

/// Lehrer-Klick „Karteikarten gemeinsam“ (Tablet): neues beaconId → SuS öffnen das Modal per Poll.
model LessonCollabFlashcardBeacon {
  groupId    String
  lessonPath String
  beaconId   String
  updatedAt  DateTime      @updatedAt
  group      LearningGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, lessonPath])
  @@index([groupId])
}

model LessonSharedInput {
  id         String        @id @default(uuid())
  groupId    String
  lessonPath String
  content    String        @default("")
  updatedAt  DateTime      @updatedAt
  group      LearningGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  @@unique([groupId, lessonPath])
  @@index([groupId])
}

model LessonSharedInputShare {
  id         String        @id @default(uuid())
  groupId    String
  lessonPath String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  group      LearningGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  @@unique([groupId, lessonPath])
  @@index([groupId])
}

model TeacherLessonInstruction {
  id         String   @id @default(uuid())
  teacherId String
  lessonPath String
  content    String   @default("{}")
  updatedAt  DateTime @updatedAt
  teacher    User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  @@unique([teacherId, lessonPath])
  @@index([teacherId])
}

model Subject {
  id             String          @id @default(uuid())
  name           String
  description    String?
  order          Int             @default(0)
  teacherId      String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  blocks         Block[]
  teacher        User            @relation(fields: [teacherId], references: [id])
  flashcardDecks FlashcardDeck[]
}

model Block {
  id          String   @id @default(uuid())
  name        String
  description String?
  order       Int      @default(0)
  subjectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  subject     Subject  @relation(fields: [subjectId], references: [id])
  units       Unit[]
}

model Unit {
  id          String   @id @default(uuid())
  name        String
  description String?
  order       Int      @default(0)
  blockId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  topics      Topic[]
  block       Block    @relation(fields: [blockId], references: [id])
}

model Topic {
  id          String   @id @default(uuid())
  name        String
  description String?
  order       Int      @default(0)
  unitId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lessons     Lesson[]
  unit        Unit     @relation(fields: [unitId], references: [id])
}

model Lesson {
  id            String           @id @default(uuid())
  name          String
  description   String?
  order         Int              @default(0)
  topicId       String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  topic         Topic            @relation(fields: [topicId], references: [id])
  materials     LessonMaterial[]
  lessonQuizzes LessonQuiz[]
}

model GroupAssignment {
  id           String        @id @default(uuid())
  groupId      String
  type         String
  refId        String
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())
  group        LearningGroup @relation(fields: [groupId], references: [id])
}

model Note {
  id        String   @id @default(uuid())
  title     String
  content   String
  authorId  String
  isPrivate Boolean  @default(true)
  tags      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
}

model Material {
  id              String           @id @default(uuid())
  fileName        String
  filePath        String
  type            String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  lessonMaterials LessonMaterial[]
}

model LessonMaterial {
  id         String   @id @default(uuid())
  lessonId   String
  materialId String
  createdAt  DateTime @default(now())
  material   Material @relation(fields: [materialId], references: [id])
  lesson     Lesson   @relation(fields: [lessonId], references: [id])
}

model Quiz {
  id               String         @id @default(uuid())
  title            String
  description      String?
  sourceFile       String
  shuffleQuestions Boolean        @default(true)
  shuffleAnswers   Boolean        @default(true)
  timeLimit        Int            @default(30)
  teacherId        String
  gradeCategory    String? // New field for grade category
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  lessonQuizzes    LessonQuiz[]
  teacher          User           @relation(fields: [teacherId], references: [id])
  questions        QuizQuestion[]
  sessions         QuizSession[]
}

model QuizQuestion {
  id            String       @id @default(uuid())
  question      String
  correctAnswer String
  options       String
  tip           String       @default("")
  explanation   String       @default("")
  order         Int
  quizId        String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  answers       QuizAnswer[]
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model LessonQuiz {
  id        String   @id @default(uuid())
  lessonId  String
  quizId    String
  createdAt DateTime @default(now())
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, quizId])
}

model QuizSession {
  id              String              @id @default(uuid())
  quizId          String
  isActive        Boolean             @default(false)
  startedAt       DateTime?
  endedAt         DateTime?
  resultsReleased Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @default(now())
  participations  QuizParticipation[]
  quiz            Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizParticipation {
  id          String       @id @default(uuid())
  sessionId   String
  studentId   String
  startedAt   DateTime?
  completedAt DateTime?
  score       Int?
  maxScore    Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  answers     QuizAnswer[]
  student     User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session     QuizSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
}

model QuizAnswer {
  id              String            @id @default(uuid())
  participationId String
  questionId      String
  selectedAnswer  String
  isCorrect       Boolean
  points          Int               @default(0)
  answeredAt      DateTime          @default(now())
  question        QuizQuestion      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  participation   QuizParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  @@unique([participationId, questionId])
}

model FileSystemPath {
  id        String   @id @default(uuid())
  path      String   @unique
  name      String
  teacherId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teacher   User     @relation(fields: [teacherId], references: [id])
}

// File sharing for learning groups
model FileShare {
  id        String        @id @default(uuid())
  filePath  String // Full path to the file
  groupId   String // Learning group ID
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  group     LearningGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([filePath, groupId])
  @@index([groupId])
  @@index([filePath])
}

// Flashcard System Models
model FlashcardDeck {
  id          String   @id @default(uuid())
  title       String
  description String?
  subjectId   String?
  teacherId   String
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject          Subject?                   @relation(fields: [subjectId], references: [id])
  teacher          User                       @relation(fields: [teacherId], references: [id])
  cards            Flashcard[]
  assignments      FlashcardAssignment[]
  learningSessions FlashcardLearningSession[]
}

model Flashcard {
  id         String   @id @default(uuid())
  deckId     String
  front      String // Vorderseite (Frage/Begriff)
  back       String // Rückseite (Antwort/Definition)
  hint       String? // Optionaler Tipp
  difficulty Int      @default(1) // 1-5
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  deck     FlashcardDeck       @relation(fields: [deckId], references: [id], onDelete: Cascade)
  progress FlashcardProgress[]
}

model FlashcardAssignment {
  id        String    @id @default(uuid())
  deckId    String
  groupId   String
  dueDate   DateTime?
  createdAt DateTime  @default(now())

  deck  FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  group LearningGroup @relation(fields: [groupId], references: [id])
}

model FlashcardProgress {
  id           String    @id @default(uuid())
  cardId       String
  studentId    String
  level        Int       @default(0) // Spaced Repetition Level (0-5)
  nextReview   DateTime  @default(now())
  lastReviewed DateTime?
  reviewCount  Int       @default(0)
  easeFactor   Float     @default(2.5) // Ease Factor für SM-2 Algorithmus
  interval     Int       @default(1) // Tage bis zur nächsten Wiederholung
  quality      Int? // Letzte Bewertung der Karte (1=Sehr schlecht, 2=Schlecht, 3=Mittelmäßig, 4=Gut, 5=Sehr gut)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  card    Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  student User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([cardId, studentId])
}

// Tracking für verarbeitete Word-Dokumente
model DocumentProcessingHistory {
  id          String   @id @default(uuid())
  sourceFile  String // Vollständiger Dateipfad
  fileName    String // Dateiname
  teacherId   String
  action      String // "created_deck" oder "added_to_deck"
  deckId      String // ID des betroffenen Decks
  deckTitle   String // Titel des Decks
  cardsCount  Int // Anzahl der hinzugefügten Karten
  processedAt DateTime @default(now())

  teacher User @relation(fields: [teacherId], references: [id])

  @@unique([sourceFile, teacherId, action, deckId])
}

// Lern-Sessions für Tracking und Statistiken
model FlashcardLearningSession {
  id               String    @id @default(uuid())
  studentId        String
  deckId           String
  startTime        DateTime  @default(now())
  endTime          DateTime?
  cardsReviewed    Int       @default(0)
  correctAnswers   Int       @default(0)
  incorrectAnswers Int       @default(0)
  sessionDuration  Int? // Dauer in Sekunden
  createdAt        DateTime  @default(now())

  student User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  deck    FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
}

// Abgabesystem für Hausaufgaben (H__ Dateien)
model Assignment {
  id        String   @id @default(uuid())
  fileName  String // Name der H__ Datei
  filePath  String // Pfad zur Original-H__ Datei
  teacherId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher     User         @relation("TeacherAssignments", fields: [teacherId], references: [id])
  submissions Submission[]

  @@unique([filePath, teacherId])
}

model Submission {
  id               String    @id @default(uuid())
  assignmentId     String
  studentId        String
  originalFileName String // Original-Dateiname der hochgeladenen Datei
  storedFileName   String // Gespeicherter Dateiname (UUID basiert)
  filePath         String // Pfad zur gespeicherten Datei
  fileType         String // MIME type
  fileSize         Int // Größe in Bytes
  submittedAt      DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  teacherComment   String? // Kommentar der Lehrkraft
  commentedAt      DateTime? // Wann wurde kommentiert

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, studentId])
  @@index([studentId])
  @@index([assignmentId])
}

model WochenaufgabeTask {
  id                  String    @id @default(uuid())
  groupId             String
  lessonPath          String
  activatedAt         DateTime?
  videoClaimStudentId String?
  videoClaimedAt      DateTime?
  peerAssignedAt      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  group             LearningGroup           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  videoClaimStudent User?                   @relation("WaVideoClaim", fields: [videoClaimStudentId], references: [id], onDelete: SetNull)
  peerPairs         WochenaufgabePeerPair[]

  @@unique([groupId, lessonPath])
  @@index([groupId])
}

model WochenaufgabePeerPair {
  id                  String @id @default(uuid())
  taskId              String
  reviewerStudentId   String
  solutionStudentId   String

  task            WochenaufgabeTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewer        User              @relation("WaPeerReviewer", fields: [reviewerStudentId], references: [id], onDelete: Cascade)
  solutionOwner   User              @relation("WaPeerSolution", fields: [solutionStudentId], references: [id], onDelete: Cascade)

  @@unique([taskId, reviewerStudentId])
  @@index([taskId])
}

model Participation {
  id          String        @id @default(uuid())
  groupId     String
  lessonIndex Int
  studentId   String
  value       Int // -2 (sehr schlecht), -1 (schlecht), 0 (neutral), 1 (gut), 2 (sehr gut)
  comment     String? // Optionaler Kommentar des Lehrers
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  group       LearningGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student     User          @relation("StudentParticipations", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([groupId, lessonIndex, studentId])
  @@index([groupId])
  @@index([studentId])
  @@index([groupId, lessonIndex])
}

// EPO-Noten (Ergebnisse der Mitarbeitsbewertungen pro Zeitraum)
model ParticipationPeriodGrade {
  id           String        @id @default(uuid())
  groupId      String
  studentId    String
  period       Int // 1 oder 2 (EPO 1 oder EPO 2)
  grade        Float // Berechnete Note (1.0-5.0)
  averageValue Float // Durchschnittswert der Teilnahmen (-2 bis +2)
  lessonCount  Int // Anzahl der bewerteten Stunden in diesem Zeitraum
  isReleased   Boolean       @default(false) // Freigabe für Schüler
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  group        LearningGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student      User          @relation("StudentEPOGrades", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([groupId, studentId, period])
  @@index([groupId])
}

model LessonKeyword {
  id          String        @id @default(uuid())
  groupId     String
  lessonIndex Int
  keyword     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  group       LearningGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, lessonIndex])
  @@index([groupId])
}

// Adventskalender System
model AdventCalendarDoor {
  id            String                     @id @default(uuid())
  day           Int // 1-24 (Tag im Dezember)
  year          Int // Jahr (z.B. 2024)
  funFact       String // Fun Fact mit Mathe/Informatik-Bezug
  question      String // Frage zur Aufgabe
  correctAnswer String // Korrekte Antwort
  explanation   String? // Erklärung der Lösung
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  submissions   AdventCalendarSubmission[]

  @@unique([day, year])
  @@index([year, day])
}

model AdventCalendarSubmission {
  id          String             @id @default(uuid())
  doorId      String
  studentId   String
  answer      String // Antwort des Schülers
  isCorrect   Boolean            @default(false)
  submittedAt DateTime           @default(now())
  door        AdventCalendarDoor @relation(fields: [doorId], references: [id], onDelete: Cascade)
  student     User               @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([doorId, studentId])
  @@index([doorId])
  @@index([studentId])
  @@index([doorId, submittedAt])
}

// Klassenarbeits-System
model KASubmission {
  id          String         @id @default(uuid())
  kaFilePath  String // Pfad zur KA-Datei (z.B. "KA_prozent-zinsrechnung.html")
  studentId   String
  submittedAt DateTime       @default(now())
  expiredAt   DateTime? // Zeitpunkt wenn Zeit abgelaufen ist
  status      String         @default("submitted") // submitted, expired, corrected
  answers     String // JSON mit allen Antworten des Schülers
  autoPoints  Float          @default(0) // Automatisch berechnete Punkte
  totalPoints Float          @default(0) // Gesamtpunkte nach Korrektur
  isReleased  Boolean        @default(false) // Freigabe für Schüler
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  student     User           @relation("StudentKASubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  corrections KACorrection[]

  @@unique([kaFilePath, studentId])
  @@index([kaFilePath])
  @@index([studentId])
  @@index([status])
}

model KACorrection {
  id           String       @id @default(uuid())
  submissionId String
  teacherId    String
  taskNumber   String // z.B. "1", "2a", "3b"
  manualPoints Float? // Manuell vergebene Punkte (für Rechenweg, etc.)
  comment      String? // Kommentar des Lehrers
  correctedAt  DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  submission   KASubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  teacher      User         @relation("TeacherKACorrections", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([submissionId, taskNumber])
  @@index([submissionId])
  @@index([teacherId])
}

// Nachrichten-System (Inbox)
model Message {
  id          String   @id @default(uuid())
  teacherId   String
  studentId   String
  subject     String
  content     String
  isRead      Boolean  @default(false)
  readAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  teacher     User     @relation("TeacherMessages", fields: [teacherId], references: [id], onDelete: Cascade)
  student     User     @relation("StudentMessages", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([teacherId])
  @@index([isRead])
  @@index([createdAt])
}

/// Lehrkraft-Einstellungen für Stundenplan (Zeitfenster, Zeittafel Johnny)
model TeacherScheduleSettings {
  id                 String   @id @default(uuid())
  teacherId          String   @unique
  startWindowMinutes Int      @default(5)
  endWindowMinutes   Int      @default(5)
  /// JSON: [{ period: 1, start: "08:00", end: "08:45" }, …]
  periodTimes        String   @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  teacher            User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

/// Hochgeladene Stundenplan-Dateien (PDF/Bild)
model TeacherTimetableUpload {
  id         String   @id @default(uuid())
  teacherId  String
  filename   String
  filePath   String
  isCurrent  Boolean  @default(false)
  uploadedAt DateTime @default(now())
  teacher    User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
}

/// Zuordnung Lerngruppe → Wochentag + Unterrichtsstunde
model ScheduleSlot {
  id           String        @id @default(uuid())
  teacherId    String
  groupId      String
  dayOfWeek    Int
  periodNumber Int
  lessonPath   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  teacher      User          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  group        LearningGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([teacherId, dayOfWeek, periodNumber])
  @@index([teacherId])
  @@index([groupId])
}

/// Automatisch gestartete/beendete Unterrichtsstunde (pro Tag + Slot)
model AutoLessonSession {
  id           String        @id @default(uuid())
  teacherId    String
  groupId      String
  sessionDate  String
  dayOfWeek    Int
  periodNumber Int
  lessonPath   String?
  opensAt      DateTime
  startsAt     DateTime
  endsAt       DateTime
  closesAt     DateTime
  status       String        @default("OPEN")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  teacher      User          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  group        LearningGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, sessionDate, periodNumber])
  @@index([teacherId, sessionDate])
  @@index([groupId, status])
  @@index([status, opensAt])
}
