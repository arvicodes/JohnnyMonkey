{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "scripts": {
    "dev": "nodemon src/index.ts",
    "dev:smart": "./scripts/start-dev.sh",
    "dev:clean": "npm run cleanup && npm run dev",
    "cleanup": "node -e \"const { exec } = require('child_process'); exec('lsof -ti:3001 | xargs kill -9 2>/dev/null || echo \\\"No process on port 3001\\\"', console.log);\"",
    "build": "tsc",
    "postbuild": "prisma generate",
    "start": "prisma generate && node dist/index.js",
    "start:prod": "NODE_ENV=production prisma generate && node dist/index.js",
    "start:smart": "node -e \"const { PortManager } = require('./dist/utils/portManager'); PortManager.cleanupPorts().then(() => require('./dist/index.js'));\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "@types/adm-zip": "^0.5.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "adm-zip": "^0.5.16",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.44.3",
    "drizzle-zod": "^0.8.2",
    "express": "^4.18.3",
    "libreoffice-convert": "^1.6.1",
    "mammoth": "^1.10.0",
    "multer": "^2.0.2",
    "officegen": "^0.6.5",
    "pdf-parse": "^1.1.1",
    "pptxjs": "^0.0.0",
    "prisma": "^6.11.1",
    "typescript": "^5.3.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "@types/pdf-parse": "^1.1.5",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
